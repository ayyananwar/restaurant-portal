{
  "name": "restaurant-portal",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.server.json && vite build",
    "check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "npm run check && npm run build && node --test",
    "test:startup": "node --test scripts/startup-check.js",
    "test:browser": "node scripts/browser-check.js",
    "test:billing-browser": "node scripts/billing-browser-check.js",
    "test:hosted": "node --test scripts/hosted-check.js",
    "test:windows": "node --test scripts/windows-check.js",
    "check:staging": "node scripts/staging-check.js",
    "test:all": "npm run test && npm run test:startup && npm run test:browser && npm run test:billing-browser",
    "start": "node dist/server/main.js",
    "setup": "node dist/server/setup.js",
    "setup:hosted": "node dist/hosted/setup.js",
    "start:hosted": "node dist/hosted/main.js"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "fastify": "^5.12.8",
    "fflate": "^0.8.3",
    "lucide-react": "^1.72.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19",
    "react-dom": "^19",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.14.0",
    "jsqr": "^1.4.0",
    "playwright": "^1.65.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vite": "^7"
  }
}
